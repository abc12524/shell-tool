DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
BAIDU_QIANFAN_KEY=
OPENVIKING_URL=
OPENVIKING_KEY=
OPENVIKING_USER=
OPENVIKING_AGENT=default

# ===== OpenViking 记忆检索 =====
OV_SCORE_THRESHOLD=0.35   # openviking_search 工具默认相似度阈值（0~1，运行时可被 LLM 传参覆盖）
OV_SEARCH_LIMIT=3         # openviking_search 工具默认返回条数上限（0~10，运行时可被 LLM 传参覆盖）
OV_INJECT_LIMIT=3         # 自动注入到上下文的记忆条数上限
OV_INJECT_THRESHOLD=0.4   # 自动注入召回的相似度阈值（0~1）；官方后端默认 0.3 杂音多，此处调高滤除低相关记忆

# 官方结构对齐（可选，默认保持原有跨项目召回行为）
OV_RECALL_PEER_SCOPE=all         # all=跨项目召回; actor=仅本 workspace 隔离召回
OV_WORKSPACE_PEER=false          # true=按项目目录派生 peer 隔离（写入/召回按项目分隔）
OV_PEER_ID=                      # 显式指定 peer（优先级最高，覆盖上面两项）
OV_PROFILE_TOKEN_BUDGET=1000     # 会话开始记忆索引块字符预算
OV_MIN_QUERY_LENGTH=3            # 召回 query 最小长度，过短跳过
OV_AUTO_CAPTURE=false             # true=自动把对话写入 OV session 并提交触发记忆提取
OV_CAPTURE_ASSISTANT_TURNS=true    # false=捕获时丢弃 assistant 轮（仅记 user/工具结果）
OV_CAPTURE_MAX_LENGTH=24000        # 单条消息捕获的最大字符数
OV_CAPTURE_TOOL_MAX_CHARS=2000     # 工具结果捕获的最大字符数

# ===== 数据库存储 =====
# DB_ONLINE: true=在线 MySQL；false=本地 SQLite（MySQL 连接失败也会自动降级 SQLite）
DB_ONLINE=true
# 本地 SQLite 文件路径（使用 SQLite 时生效，默认 data/shell_tool.db）
SQLITE_DB_PATH=

# ===== MySQL 会话存储（在线） =====
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DB=

# ===== 工具调用 =====
MAX_TOOL_ROUNDS=6
