DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
BAIDU_QIANFAN_KEY=
OPENVIKING_URL=
OPENVIKING_KEY=
OPENVIKING_USER=
OPENVIKING_AGENT=default

# ===== OpenViking 记忆检索 =====
OV_SCORE_THRESHOLD=0.35   # openviking_search 工具与自动注入的默认相似度阈值（0~1）
OV_SEARCH_LIMIT=3         # openviking_search 工具默认返回条数上限（0~10，运行时可被 LLM 传参覆盖）
OV_INJECT_LIMIT=5         # 自动注入到上下文的记忆条数上限

# ===== MySQL 会话存储 =====
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DB=

# ===== 工具调用 =====
MAX_TOOL_ROUNDS=6
