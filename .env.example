DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# ===== LLM 接入方式 =====
# responses = DeepSeek 官方 Responses API（默认；支持服务端内置 web_search）
# chat      = OpenAI 兼容 Chat Completions API（OpenCode Zen / OpenCode Go 等网关）
DEEPSEEK_API_TYPE=responses
# 服务商标识（决定计费/峰谷/余额策略）：deepseek / opencode-go；留空按 DEEPSEEK_BASE_URL 自动推断
LLM_PROVIDER=
# 会话标识请求头名：OpenCode Go 建议每个会话稳定携带（提升路由/前缀缓存命中）；
# 留空时 OpenCode 系自动启用 x-opencode-session，其它服务商不发送
LLM_SESSION_HEADER=
# 客户端 User-Agent：OpenCode Go 建议使用自有客户端名而非通用 SDK 名；留空用 SDK 默认
LLM_USER_AGENT=

# ----- 接入 OpenCode Go 的 DeepSeek V4.1 Flash（把上面 DEEPSEEK_* 换成以下值）-----
# DEEPSEEK_BASE_URL=https://opencode.ai/zen/go/v1
# DEEPSEEK_MODEL=deepseek-v4.1-flash
# DEEPSEEK_API_TYPE=chat
# LLM_PROVIDER=opencode-go
# LLM_SESSION_HEADER=x-opencode-session
# LLM_USER_AGENT=shell-tool/1.0
BAIDU_QIANFAN_KEY=
FEEDCOOP_API_KEY=
OPENVIKING_URL=
OPENVIKING_KEY=
OPENVIKING_USER=
OPENVIKING_AGENT=default

# ===== OpenViking 记忆检索 =====
# search 接口（上下文感知）工具默认阈值与返回条数（0~1 / 0~10，运行时 LLM 可传参覆盖）
OV_SEARCH_THRESHOLD=0.4
OV_SEARCH_LIMIT=3
# find 接口（纯向量语义搜索）工具默认阈值与返回条数；自动注入也使用本组配置
OV_FIND_THRESHOLD=0.4
OV_FIND_LIMIT=3

# 官方结构对齐（可选，默认保持原有跨项目召回行为）
# all=跨项目召回; actor=仅本 workspace 隔离召回
OV_RECALL_PEER_SCOPE=all
# true=按项目目录派生 peer 隔离（写入/召回按项目分隔）
OV_WORKSPACE_PEER=false
# 显式指定 peer（优先级最高，覆盖上面两项）；留空则回退 default
OV_PEER_ID=
# OpenViking 总开关：false=关闭所有自动上下文注入（会话记忆索引 + 相关记忆召回）；
# 仅影响自动注入，模型仍可主动调用 ov 工具搜索/读写记忆。
OV_ENABLED=true
# 会话开始记忆索引块字符预算
OV_PROFILE_TOKEN_BUDGET=1000
# 召回 query 最小长度，过短跳过
OV_MIN_QUERY_LENGTH=3
# true=自动把对话写入 OV session 并提交触发记忆提取
OV_AUTO_CAPTURE=false
# false=捕获时丢弃 assistant 轮（含工具轮，仅记 user）
OV_CAPTURE_ASSISTANT_TURNS=true
# 单条消息捕获的最大字符数
OV_CAPTURE_MAX_LENGTH=24000
# 工具调用/结果捕获的最大字符数（原文上传，服务端按阈值外部化截断）
OV_CAPTURE_TOOL_MAX_CHARS=1000000

# ===== 数据库存储 =====
# 本地 SQLite 是唯一读写源；DB_ONLINE=true 时额外把数据幂等同步到在线 MySQL
# DB_ONLINE: true=开启在线 MySQL 同步（默认）；false=仅本地 SQLite（未配置或连接失败也会仅用 SQLite）
DB_ONLINE=true
# 本地 SQLite 文件路径（唯一读写源，默认 data/shell_tool.db）
SQLITE_DB_PATH=

# ===== MySQL 会话存储（在线同步副本） =====
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DB=

# ===== 工具调用 =====
MAX_TOOL_ROUNDS=6
# LLM 内置 web 搜索（DeepSeek Responses API 自带联网搜索）开关：false=关闭（默认）/ true=开启
LLM_WEB_SEARCH=false
