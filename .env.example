# ============================================================
#  shell-tool 配置示例
#  复制为 .env 后按需修改。等号右边的值就是默认值，注释里的值是可选值。
#  部署（python deploy.py）后本文件位于 ~/.config/shell-tool/.env，
#  data/ 与 skill/ 也在该目录；自定义目录用环境变量 SHELL_TOOL_HOME
#  （需在启动前设置，写在本文件里不生效）。
# ============================================================

# ===== LLM 接入方式 =====
# responses = DeepSeek 官方 Responses API（默认；支持服务端内置 web_search）
# chat      = OpenAI 兼容 Chat Completions API（OpenCode Zen / OpenCode Go 等网关）
DEEPSEEK_API_TYPE=responses
# 服务商标识（决定计费/峰谷/余额策略）：deepseek / opencode-go；留空按 DEEPSEEK_BASE_URL 自动推断
LLM_PROVIDER=
# 会话标识请求头名：OpenCode Go 建议每个会话稳定携带（提升路由 / 前缀缓存命中）；
# 留空时 OpenCode 系自动启用 x-opencode-session，其它服务商不发送
LLM_SESSION_HEADER=
# 客户端 User-Agent：OpenCode Go 建议使用自有客户端名而非通用 SDK 名；留空则不发该请求头
LLM_USER_AGENT=

# ----- 当前生效的这一套 -----
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_API_KEY=

# ----- 例：接入 OpenCode Go 的 DeepSeek V4.1 Flash（替换上面这套）-----
# DEEPSEEK_BASE_URL=https://opencode.ai/zen/go/v1
# DEEPSEEK_MODEL=deepseek-v4.1-flash
# DEEPSEEK_API_TYPE=chat
# LLM_PROVIDER=opencode-go
# LLM_SESSION_HEADER=x-opencode-session
# LLM_USER_AGENT=shell-tool/1.0

# ===== 用户自定义提示（每会话注入一次）=====
# 内容会包在 <system-reminder><user_tips>...</user_tips> 内（键名大小写都认）；
# 双引号包裹时可用 \n 表示换行，例如：
# user_tips="第一条提示\n第二条提示"
user_tips=

# ===== OpenViking 记忆服务 =====
# 连接信息；URL 留空则记忆功能整体不启用
OPENVIKING_URL=
OPENVIKING_KEY=
OPENVIKING_USER=
OPENVIKING_AGENT=default

# ----- 读取 → 注入：何时把检索结果注入上下文 -----
#   off=不自动注入
#   question=每轮以用户问题为 query 检索注入（默认）
#   step=每个工具轮后以整批消息为 query 检索注入
#   both=两者都开
OV_INJECT=question
# 会话开始是否注入记忆索引（profile）
OV_PROFILE=false
# find 接口（纯向量语义搜索）的阈值与返回条数；自动注入也用这组值
OV_FIND_THRESHOLD=0.5
OV_FIND_LIMIT=2
# 召回 query 最小长度，过短跳过
OV_MIN_QUERY_LENGTH=3
# 跨轮去重轮数：最近 N 轮已注入过的记忆 URI 不再召回，避免反复刷屏；0=关闭
OV_RECALL_DEDUP_TURNS=5
# 会话开始记忆索引块的字符预算
OV_PROFILE_TOKEN_BUDGET=1000

# ----- 写入 → 抓取：对话结束后回写并触发记忆提取 -----
# true=把对话写入 OV session 并在结束时 commit 触发记忆提取
OV_CAPTURE=false
# 抓取范围：true=assistant 轮也写入（默认）/ false=丢弃 assistant 轮，只记 user 与工具结果
OV_CAPTURE_ASSISTANT_TURNS=true
# 单条消息捕获的最大字符数
OV_CAPTURE_MAX_LENGTH=24000
# 工具结果捕获的最大字符数（原文上传，服务端按阈值外部化截断）
OV_CAPTURE_TOOL_MAX_CHARS=1000000

# ----- peer 隔离（可选）-----
# true=按项目目录派生 peer 隔离（写入 / 召回按项目分隔）
OV_WORKSPACE_PEER=false
# 显式指定 peer（优先级最高，覆盖上面项）；留空则回退 default
OV_PEER_ID=

# ===== 数据库存储 =====
# 本地 SQLite 是唯一读写源；DB_ONLINE=true 时额外把数据幂等同步到在线 MySQL（连接失败则退回仅 SQLite）
DB_ONLINE=true
# 本地 SQLite 文件路径（默认 data/shell_tool.db）
SQLITE_DB_PATH=

# ===== MySQL 会话存储（在线同步副本） =====
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DB=

# ===== 工具调用 =====
# 单轮对话里最多连续几轮工具调用
MAX_TOOL_ROUNDS=12
# LLM 请求遇到可重试错误（429 / 5xx / 网络中断）时的最大尝试次数
MAX_API_ATTEMPTS=4
# LLM 内置 web 搜索（DeepSeek Responses API 自带联网搜索）开关：false=关闭（默认）/ true=开启
LLM_WEB_SEARCH=false

# ===== 命令输出简化（trim）=====
# 命令由本进程执行，只把文本结果交给简化技能加工；技能没装 / 出错时自动回退原始输出。
# 服务地址在 skill/rtk_web/config.json（RTK_WEB_HOST），不在这里配。
OUTPUT_TRIM_ENABLED=true
# 提供 trim() 扩展函数的技能名（先 python dp.py -I rtk_web 安装；没装则不裁剪）
OUTPUT_TRIM_SKILL=rtk_web
# 压缩模式：auto（默认，按内容类型重写，省得多）/ chain（固定链，可预期）
# 实际模式由下面的 ROUTE 按输出内容二次分配，只有不在白名单里的内容才真用 auto
OUTPUT_TRIM_MODE=auto
# 分流：diff / JSON / 源码 / 表格 / 文件列表 / 日志 / 配置文件这些「重写即丢结论」的
# 内容走 chain 保真，其余仍交给 auto。auto 会把 diff 压成只剩文件头时间戳、
# 把 JSON 掏空成 elided 标记，所以默认不让它碰这些。
#   chain_whitelist=按内容分流（默认）    off=不分流，全部用 MODE
OUTPUT_TRIM_ROUTE=chain_whitelist
# 请求格式：term（默认）/ json / web / matches / lockfile / auto
OUTPUT_TRIM_FORMAT=term
# 单次请求超时（秒）
OUTPUT_TRIM_TIMEOUT=10
# 全部 provider 失败后暂停调用多少秒（避免服务宕机时每条命令都等超时）
OUTPUT_TRIM_RETRY_SECONDS=60
# 字符预算：服务端按它裁（保首行 / 报错行 / 尾段，其余等间隔采样），
# 本地兜底截断也用这个预算（保头尾，不砍最新内容）
OUTPUT_TRIM_MAX_CHARS=6000

# ===== 账户余额查询 =====
# 留空：用 DEEPSEEK_API_KEY 查官方 {DEEPSEEK_BASE_URL}/user/balance（默认）
# 配置后：改用自建网关，此地址作为基址自动拼 /api/balance，无需 API Key
# 示例：BALANCE_URL=https://192.168.30.181:8083/
BALANCE_URL=

# ===== skill 远程仓库（skill_hub 下载源）=====
# 仓库类型：github / gitea；留空时按是否配置 SKILL_HUB_BASE 自动推断
SKILL_HUB_TYPE=
# Gitea 服务基址（配置后默认按 gitea 处理），例如 http://192.168.30.181:3000
SKILL_HUB_BASE=
# 远程技能仓库（owner/repo）与分支；留空用默认 abc12524/shell-skills@main
# Gitea 示例：SKILL_HUB_BASE=http://192.168.30.181:3000  SKILL_HUB_REPO=hollow/shell-skills
SKILL_HUB_REPO=abc12524/shell-skills
SKILL_HUB_BRANCH=main
# 私有仓库访问令牌（GitHub / Gitea 通用；GitHub 亦可用 GITHUB_TOKEN，Gitea 亦可用 GITEA_TOKEN）
SKILL_HUB_TOKEN=
